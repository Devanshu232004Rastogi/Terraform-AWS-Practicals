resource "aws_cloudwatch_log_group" "vpc_flow_log_grp" {
  name              = "${local.name_prefixes}-vpc_flow_log_cloudwatch_log_grp"
  retention_in_days = 7
}


data "aws_iam_policy_document" "vpc_flow_assume_role_policy" {
  statement {
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["vpc-flow-logs.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "flow_log_role" {
  name               = "${local.name_prefixes}-vpc_flow_log_trust_role"
  assume_role_policy = data.aws_iam_policy_document.vpc_flow_assume_role_policy.json
}

data "aws_iam_policy_document" "flow_permissions" {
  statement {
    actions = [
      "logs:CreateLogStream",
      "logs:PutLogEvents",
      "logs:DescribeLogGroups",
      "logs:DescribeLogStreams",
    ]
    resources = ["${aws_cloudwatch_log_group.vpc_flow_log_grp.arn}:*"]
  }
}

resource "aws_iam_role_policy" "flow_log_policy" {
  name   = "write-flow-logs"
  role   = aws_iam_role.flow_log_role.id
  policy = data.aws_iam_policy_document.flow_permissions.json
}


resource "aws_flow_log" "main_custom_vpc_flow_log" {
  vpc_id                   = aws_vpc.main_vpc.id
  iam_role_arn             = aws_iam_role.flow_log_role.arn
  log_destination          = aws_cloudwatch_log_group.vpc_flow_log_grp.arn
  max_aggregation_interval = 600
  traffic_type             = "ALL"
  tags                     = { Name = "${local.name_prefixes}-vpc-flow" }


}